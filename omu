<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>Attrape la mouette 🐦</title>
  <style>
    body{
      margin:0;
      height:100vh;
      display:grid;
      place-items:center;
      font-family: system-ui, -apple-system, Segoe UI, Roboto, Arial, sans-serif;
      background: linear-gradient(180deg, #e0f2fe 0%, #fff 60%);
      overflow:hidden;
    }
    .card{
      width:min(720px, 92vw);
      background:white;
      border-radius:24px;
      box-shadow:0 18px 60px rgba(2,132,199,.25);
      padding:24px 22px 70px;
      border:1px solid rgba(14,165,233,.25);
      position:relative;
      text-align:center;
    }
    h1{ margin:6px 0 8px; font-size:28px; }
    p{ margin:0 0 14px; color:#0f172a; }
    .hint{ color:#475569; font-size:14px; margin-bottom:18px; }

    /* Le bouton mouette */
    .seagull-btn{
      position:absolute;
      left:50%;
      top:60%;
      transform:translate(-50%,-50%);
      border:0;
      background:transparent;
      cursor:pointer;
      user-select:none;
      padding:0;
      outline:none;
    }

    /* Corps de mouette en CSS (simple & mignon) */
    .seagull{
      width:180px;
      height:90px;
      position:relative;
      filter: drop-shadow(0 10px 12px rgba(2,132,199,.25));
    }
    .body{
      position:absolute;
      left:34px; top:26px;
      width:110px; height:44px;
      background:#ffffff;
      border:2px solid #cbd5e1;
      border-radius:999px;
    }
    .belly{
      position:absolute;
      left:44px; top:34px;
      width:92px; height:28px;
      background:#f8fafc;
      border:2px solid #e2e8f0;
      border-radius:999px;
    }
    .head{
      position:absolute;
      left:18px; top:18px;
      width:54px; height:54px;
      background:#ffffff;
      border:2px solid #cbd5e1;
      border-radius:999px;
    }
    .eye{
      position:absolute;
      left:38px; top:38px;
      width:6px; height:6px;
      background:#0f172a;
      border-radius:999px;
    }
    .beak{
      position:absolute;
      left:6px; top:42px;
      width:26px; height:14px;
      background:#fbbf24;
      border:2px solid #f59e0b;
      border-left:0;
      border-radius:0 999px 999px 0;
      transform:skewX(-12deg);
    }
    .wing{
      position:absolute;
      left:76px; top:10px;
      width:86px; height:48px;
      background:#ffffff;
      border:2px solid #cbd5e1;
      border-radius: 999px 999px 999px 120px;
      transform: rotate(-8deg);
    }
    .wing:after{
      content:"";
      position:absolute;
      left:10px; top:18px;
      width:58px; height:18px;
      border-bottom:3px solid #cbd5e1;
      border-radius:999px;
      opacity:.85;
    }
    .tail{
      position:absolute;
      left:140px; top:40px;
      width:34px; height:20px;
      background:#ffffff;
      border:2px solid #cbd5e1;
      border-radius: 2px 999px 999px 2px;
      transform: rotate(12deg);
    }

    .label{
      display:inline-block;
      margin-top:10px;
      padding:8px 14px;
      font-weight:800;
      border-radius:999px;
      background:#e0f2fe;
      border:2px solid #7dd3fc;
      color:#075985;
      box-shadow:0 6px 0 #38bdf8;
    }

    .toast{
      position:absolute;
      left:50%;
      bottom:16px;
      transform:translateX(-50%);
      font-size:14px;
      color:#475569;
      padding:10px 14px;
      border-radius:999px;
      background:#f8fafc;
      border:1px solid #e2e8f0;
    }

    .win{
      display:none;
      margin-top:10px;
      font-size:18px;
      font-weight:900;
      color:#16a34a;
    }
  </style>
</head>
<body>
  <div class="card" id="arena">
    <h1>🎯 Mission : attrape la mouette</h1>
    <p class="hint">Approche ta souris… et tente de cliquer. (Bonne chance 😇)</p>

    <button class="seagull-btn" id="seagullBtn" aria-label="Mouette">
      <div class="seagull">
        <div class="wing"></div>
        <div class="tail"></div>
        <div class="body"></div>
        <div class="belly"></div>
        <div class="head"></div>
        <div class="beak"></div>
        <div class="eye"></div>
      </div>
      <div class="label">CLIQUE SUR MOI 🐦</div>
    </button>

    <div class="toast" id="toast">Indice : elle déteste être cliquée.</div>
    <div class="win" id="win">BRAVO 😍 Tu as attrapé la mouette ! → Bisou immédiat 💋</div>
  </div>

  <script>
    const btn = document.getElementById('seagullBtn');
    const arena = document.getElementById('arena');
    const toast = document.getElementById('toast');
    const win = document.getElementById('win');

    // Position initiale
    let x = arena.clientWidth / 2;
    let y = arena.clientHeight * 0.58;

    function clamp(v, min, max){ return Math.max(min, Math.min(max, v)); }

    function moveTo(nx, ny){
      // marges pour éviter de sortir du cadre
      const margin = 40;
      const maxX = arena.clientWidth - margin;
      const maxY = arena.clientHeight - 110;
      const minX = margin;
      const minY = 120;

      x = clamp(nx, minX, maxX);
      y = clamp(ny, minY, maxY);

      btn.style.left = x + "px";
      btn.style.top = y + "px";
      btn.style.transform = "translate(-50%,-50%)";
    }

    // Place le bouton
    btn.style.position = "absolute";
    moveTo(x, y);

    // La mouette fuit quand la souris s’approche
    function flee(e){
      const rect = arena.getBoundingClientRect();
      const mx = e.clientX - rect.left;
      const my = e.clientY - rect.top;

      // distance souris -> bouton
      const dx = x - mx;
      const dy = y - my;
      const dist = Math.sqrt(dx*dx + dy*dy);

      // plus on est proche, plus elle fuit
      const danger = 140; // rayon de panique
      if(dist < danger){
        const boost = (danger - dist) / danger; // 0..1
        const step = 120 * boost + 35;

        // direction opposée à la souris (avec un peu d'aléatoire)
        const rand = () => (Math.random() - 0.5) * 60;
        const nx = x + (dx / (dist || 1)) * step + rand();
        const ny = y + (dy / (dist || 1)) * step + rand();

        moveTo(nx, ny);
        toast.textContent = "AAAAA NON 😱 (la mouette s’enfuit)";
      }
    }

    arena.addEventListener('mousemove', flee);
    arena.addEventListener('touchstart', (e) => {
      // sur mobile, elle saute quand on touche
      const t = e.touches[0];
      flee({ clientX: t.clientX, clientY: t.clientY });
    }, { passive:true });

    // Petite chance de victoire : si elle clique quand même (ou sur mobile)
    btn.addEventListener('click', () => {
      toast.textContent = "😳 IMPOSSIBLE… tu l’as eue !";
      win.style.display = "block";
      // elle arrête de fuir
      arena.removeEventListener('mousemove', flee);
      btn.style.cursor = "default";
    });
  </script>
</body>
</html>
